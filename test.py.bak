import flet as ft
import threading
import time
import queue
import asyncio


def main(page: ft.Page):
    page.title = "Agix Chat Demo"
    page.window.width = 800
    page.window.height = 600
    page.padding = 0

    page.appbar = ft.AppBar(
        leading=ft.Text("🤖", size=28),
        leading_width=50,
        title=ft.Text("Agix AI Assistant", size=18),
        bgcolor=ft.Colors.SURFACE,
    )

    chat_list = ft.ListView(expand=True, spacing=10, padding=20, auto_scroll=True)

    # ---------- 两个线程安全队列 ----------
    display_queue = queue.Queue()  # 后台线程 -> 主线程 显示消息 (text, is_user)
    input_queue = queue.Queue()    # 主线程 -> 线程2 用户输入文本

    # 用于同步定时器阻塞/唤醒
    answer_event = threading.Event()
    answer_event.set()  # 初始为已设置，表示没有未回答问题（允许用户自由输入）

    def add_message(text: str, is_user: bool = False):
        """主线程调用，直接添加消息并刷新"""
        color = ft.Colors.BLUE_50 if not is_user else ft.Colors.GREEN_50
        label = "你" if is_user else "🤖 Agix"
        chat_list.controls.append(
            ft.Container(
                content=ft.Text(f"{label}\n{text}", size=14, selectable=True),
                bgcolor=color,
                border_radius=12,
                padding=ft.Padding(left=12, right=12, top=12, bottom=12),
            )
        )
        page.update()

    async def poll_messages():
        """异步轮询显示队列，不断刷新 UI"""
        while True:
            while not display_queue.empty():
                try:
                    text, is_user = display_queue.get_nowait()
                    add_message(text, is_user)
                except queue.Empty:
                    break
            await asyncio.sleep(0.2)

    # ========= 线程1：定时器线程 =========
    def timer_thread():
        """每 10 秒发送“你是谁？”，然后阻塞等待用户回答"""
        while True:
            time.sleep(10)
            # 发送问题到界面
            display_queue.put(("你是谁？", False))
            # 清除事件，表示等待回答
            answer_event.clear()
            # 阻塞直到用户回答后事件被设置
            answer_event.wait()

    # ========= 线程2：输入处理线程 =========
    def input_handler_thread():
        """监听用户输入，根据状态回复不同内容"""
        while True:
            user_input = input_queue.get()  # 阻塞等待用户输入
            if not answer_event.is_set():
                # 有未回答的问题，本次输入是回答
                display_queue.put(("hello", False))  # 线程2回复
                answer_event.set()  # 唤醒定时器线程，重新开始10秒倒计时
            else:
                # 没有未回答问题，输入由线程1处理
                display_queue.put(("hello 线程1", False))

    # ========= 启动两个后台线程 =========
    threading.Thread(target=timer_thread, daemon=True).start()
    threading.Thread(target=input_handler_thread, daemon=True).start()

    # ========= UI 部分 =========
    input_field = ft.TextField(
        hint_text="输入消息...",
        border_radius=12,
        min_lines=1,
        max_lines=4,
        expand=True,
    )

    def send_message():
        """用户发送消息：先显示自己输入，再交给后台线程处理"""
        text = input_field.value.strip()
        if not text:
            return
        # 显示用户消息
        add_message(text, is_user=True)
        input_field.value = ""
        # 将用户输入放入队列，供线程2处理
        input_queue.put(text)

    input_field.on_submit = lambda e: send_message()

    page.add(
        ft.Column(
            [
                chat_list,
                ft.Divider(height=1),
                ft.Container(
                    content=ft.Row(
                        [
                            input_field,
                            ft.Button("发送", on_click=lambda _: send_message()),
                        ]
                    ),
                    padding=ft.Padding(left=12, right=12, top=8, bottom=8),
                ),
            ],
            expand=True,
        )
    )

    # 初始欢迎消息
    add_message("你好！我是 Agix，你的 AI 开发助手。")

    # 启动异步轮询器
    page.run_task(poll_messages)


ft.run(main)