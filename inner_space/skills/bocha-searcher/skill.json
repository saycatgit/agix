{
  "name": "bocha-searcher",
  "version": "1.0.0",
  "description": "使用博查(Bocha)API搜索互联网资料，返回网页标题、摘要和链接",
  "author": "agent",
  "entrypoint": "scripts/main.py",
  "invoke": "cli",
  "schema": {
    "params": {
      "query": {
        "type": "string",
        "description": "搜索关键词",
        "default": ""
      },
      "max_results": {
        "type": "integer",
        "description": "最大结果数",
        "default": 10
      },
      "format": {
        "type": "string",
        "description": "输出格式：json 或 text",
        "default": "json"
      }
    }
  }
}
